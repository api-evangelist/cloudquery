{
  "opencollection": "1.0.0",
  "info": {
    "name": "CloudQuery Platform OpenAPI Spec admin Openapi.json API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Openapi.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get OpenAPI JSON",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/openapi.json"
          },
          "docs": "Returns the OpenAPI definition in JSON format."
        }
      ]
    }
  ],
  "bundled": true
}